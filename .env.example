# Centralized Resend Infrastructure (Platform-managed — never expose to client)
RESEND_API_KEY=your_resend_api_key_here
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret_here

# Server-side Session Signing Secret (recommended in production)
FLOWPILOT_SESSION_SECRET=change_this_to_a_long_random_secret

# Evolution API WhatsApp Gateway (v2.3.5)
EVOLUTION_URL=https://incomestream.duckdns.org
EVOLUTION_API_KEY=your_evolution_api_key_here

# App port
PORT=3000